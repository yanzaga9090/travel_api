# docker-compose.yml-д зориулсан тохиргоо.
# Энэ файлыг ".env" нэрээр хуулж, утгуудаа бөглөнө:  cp .env.example .env
# .env файл GitHub-д ОРОХГҮЙ (.gitignore-д бий).

# Серверийн гадаад хаяг (порт бичихгүй). Өөрийн компьютер дээр туршихад: localhost
EC2_IP=YOUR_EC2_PUBLIC_IP

# Сангийн нууц үг (өөрөө зохионо)
POSTGRES_PASSWORD=CHANGE_ME

# Токены нууц түлхүүр (32+ тэмдэгт). Үүсгэх: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
