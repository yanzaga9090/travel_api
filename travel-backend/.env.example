# Энэ файлыг .env нэрээр хуулж, өөрийн утгаа бөглөнө үү.
# .env файлыг хэзээ ч git-д оруулахгүй!

# PostgreSQL холболт: postgresql://ХЭРЭГЛЭГЧ:НУУЦ_ҮГ@ХОСТ:ПОРТ/travel_db
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/travel_db

# Frontend-ийн хаяг(ууд), таслалаар тусгаарлана
ALLOWED_ORIGINS=http://FRONTEND_HOST:5500

# Загварын файлын зам (Prompt 6-д ашиглана)
MODEL_PATH=models/demand_model.joblib

# Токен гарын үсгийн нууц түлхүүр. Үүсгэх: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
# Токен хэдэн минут хүчинтэй байх
JWT_EXPIRE_MINUTES=60
